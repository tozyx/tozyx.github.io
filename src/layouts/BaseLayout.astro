---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title?: string; description?: string; locale?: 'zh' | 'en'; }
const { locale='zh', title=locale==='en'?'GenshinPiano · Music composition and performance for Genshin':'GenshinPiano · 原神自动演奏与乐谱工具', description=locale==='en'?'A Windows tool for composing, editing, and performing music with Genshin instruments.':'面向 Windows 的原神钢琴演奏、乐谱编辑与转换工具。' }=Astro.props;
const socialImage=new URL('/og.png',Astro.site); const canonical=new URL(Astro.url.pathname,Astro.site);
const alternatePath=locale==='en'?(Astro.url.pathname.replace(/^\/en(?=\/|$)/,'')||'/'):(Astro.url.pathname==='/'?'/en/':`/en${Astro.url.pathname}`); const alternateUrl=new URL(alternatePath,Astro.site);
---
<!doctype html><html lang={locale==='en'?'en':'zh-CN'}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="theme-color" content="#f6f8f5" /><meta name="generator" content={Astro.generator} /><link rel="canonical" href={canonical} /><link rel="alternate" hreflang={locale==='en'?'zh-CN':'en'} href={alternateUrl} /><link rel="alternate" hreflang={locale==='en'?'en':'zh-CN'} href={canonical} /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={socialImage} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><link rel="icon" type="image/png" href="/app-icon.png" /><title>{title}</title><script is:inline define:vars={{locale}}>try{const saved=localStorage.getItem('gpiano-locale');const wantsEnglish=saved?saved==='en':!navigator.languages.some(language=>language.toLowerCase().startsWith('zh'));const isEnglish=locale==='en';if(wantsEnglish!==isEnglish){const path=location.pathname;const target=wantsEnglish?(path.startsWith('/en/')?path:(path==='/'?'/en/':`/en${path}`)):(path.replace(/^\/en(?=\/|$)/,'')||'/');if(target!==path)location.replace(target);}}catch{}</script></head><body><SiteHeader locale={locale} /><main><slot /></main><SiteFooter locale={locale} /></body></html>