---
import BaseLayout from '../../layouts/BaseLayout.astro'; const releaseUrl='https://github.com/tozyx/GenshinPiano/releases/latest';
---
<BaseLayout locale="en" title="Download · GenshinPiano" description="Download GenshinPiano for Windows 10/11 x64 as a self-contained or framework-dependent build."><section class="page-hero shell"><span class="eyebrow">DOWNLOAD</span><h1>Choose the build for you</h1><p>Both portable ZIP builds have the same features. The self-contained build is recommended for most people.</p></section><section class="section shell download-section"><div class="release-bar" aria-live="polite"><div><span class="release-kicker">LATEST STABLE</span><strong data-release-version>Checking the latest release…</strong></div><div class="release-meta"><span data-release-date>Connecting to GitHub Releases</span><a href={releaseUrl}>All releases →</a></div></div><div class="download-switch" role="group" aria-label="Build selection"><button class="active" data-target="standalone" aria-pressed="true">Self-contained</button><button data-target="framework" aria-pressed="false">Framework-dependent</button></div><div class="download-panels"><article class="download-card active" data-panel="standalone"><div><span class="badge">Recommended</span><h2>Windows x64 self-contained</h2><p>Includes the .NET runtime. Extract and run with no additional runtime setup.</p><ul><li>Windows 10/11 x64</li><li>No .NET Desktop Runtime required</li><li>Full update and rollback support</li></ul><div class="asset-links" data-sidecars="standalone" hidden></div></div><a class="button button-primary" data-download="standalone" href={releaseUrl}><span>Open GitHub Releases</span><small></small></a></article><article class="download-card" data-panel="framework"><div><span class="badge muted">Smaller download</span><h2>Windows x64 framework-dependent</h2><p>For systems that already have the .NET 10 Desktop Runtime installed.</p><ul><li>Windows 10/11 x64</li><li>Requires .NET 10 Desktop Runtime</li><li>Same features as the self-contained build</li></ul><div class="asset-links" data-sidecars="framework" hidden></div></div><a class="button button-primary" data-download="framework" href={releaseUrl}><span>Open GitHub Releases</span><small></small></a></article></div><p class="release-error" data-release-error hidden>Latest release data is temporarily unavailable. Download buttons now open GitHub Releases.</p><aside class="notice"><strong>Install</strong><ol><li>Download and fully extract the ZIP.</li><li>Use a writable folder; do not place it in Program Files.</li><li>Run <code>GenshinPiano.exe</code>.</li></ol><p>Official packages include SHA-256 hashes and RSA signatures.</p></aside></section><script>const api='https://api.github.com/repos/tozyx/GenshinPiano/releases/latest',fallback='https://github.com/tozyx/GenshinPiano/releases/latest';const buttons=document.querySelectorAll<HTMLButtonElement>('[data-target]'),panels=document.querySelectorAll<HTMLElement>('[data-panel]');buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active));});panels.forEach(panel=>panel.classList.toggle('active',panel.dataset.panel===button.dataset.target));}));const size=(bytes:number)=>`${(bytes/1024/1024).toFixed(1)} MB`;const zip=(assets:any[],kind:string)=>assets.find(asset=>kind==='framework'?/-win-x64-framework\.zip$/.test(asset.name):/-win-x64\.zip$/.test(asset.name)&&!asset.name.includes('-framework'));const setAsset=(assets:any[],kind:string)=>{const file=zip(assets,kind);if(!file)return;const anchor=document.querySelector<HTMLAnchorElement>(`[data-download="${kind}"]`);if(anchor){anchor.href=file.browser_download_url;anchor.querySelector('span')!.textContent='Download ZIP';anchor.querySelector('small')!.textContent=size(file.size);}const links=document.querySelector<HTMLElement>(`[data-sidecars="${kind}"]`),hash=assets.find(asset=>asset.name===`${file.name}.sha256`),sig=assets.find(asset=>asset.name===`${file.name}.sig`);if(links&&(hash||sig)){links.hidden=false;links.replaceChildren();[[hash,'SHA-256'],[sig,'RSA signature']].forEach(([asset,label])=>{if(!asset)return;const link=document.createElement('a');link.href=asset.browser_download_url;link.textContent=String(label);links.append(link);});}};fetch(api,{headers:{Accept:'application/vnd.github+json'}}).then(response=>{if(!response.ok)throw new Error(String(response.status));return response.json();}).then(release=>{const version=document.querySelector<HTMLElement>('[data-release-version]'),date=document.querySelector<HTMLElement>('[data-release-date]');if(version)version.textContent=release.name||release.tag_name;if(date)date.textContent=`Published ${new Intl.DateTimeFormat('en',{dateStyle:'long'}).format(new Date(release.published_at))}`;setAsset(release.assets,'standalone');setAsset(release.assets,'framework');}).catch(()=>{const version=document.querySelector<HTMLElement>('[data-release-version]'),error=document.querySelector<HTMLElement>('[data-release-error]');if(version)version.textContent='Get it from Releases';if(error)error.hidden=false;document.querySelectorAll<HTMLAnchorElement>('[data-download]').forEach(a=>a.href=fallback);});</script></BaseLayout>