import BaseLayout from '../../layouts/BaseLayout.astro'; const sections=[['Current development build',['21-key, 88-key, and used-range piano-roll modes','MIDI import can preserve the original 0–127 pitch','Initial MusicXML import support','Refined frozen ruler, subdivisions, and measure labels']],['Reliability and desktop experience',['GitHub / GitCode update mirrors with newest-version selection','RSA-3072 and SHA-256 release verification','Safe rollback, resumable downloads, and recovery','Single instance, file association, notifications, and portable settings']],['OCR and score tools',['Experimental numbered-notation OCR add-on','Watermark suppression, staff grouping, voices, and beat reconstruction','Score analysis and 21-key range shifting','Staff OMR and correction preview remain on the roadmap']]];
