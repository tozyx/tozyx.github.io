---
import BaseLayout from '../../layouts/BaseLayout.astro';
const groups=[['Create and edit',['Editable UTF-8 JSON .gpiano projects','21-key, 88-key, and used-range piano-roll views','Marquee selection, multi-select, copy, move, zoom, undo, and redo','Beat length, key-hold duration, and snap grid']],['Import and convert',['Single MIDI import and folder batch conversion','Keep original MIDI pitch or map notes to 21 keys','MusicXML measures, voices, chords, ties, and piano parts','Batch migration for legacy .GenshinPiano scores']],['Preview and perform',['Multiple local instruments, sustain, and selection loops','Target detection for Chinese and international game clients','Three-second safety countdown and focus-loss pause','Escape to pause, Shift + F5 to stop, and forced key release']],['Smart tools',['Score quality analysis and 21-key range shifting','Optional cleanup for duplicates, overlaps, and short notes','Experimental numbered-notation OCR','Separately signed and updated OCR add-on']],['Desktop experience',['Light and dark themes with Chinese and English UI','Score library, drag-and-drop, and single-instance behavior','Windows .gpiano file association','Recovery for unsaved work']],['Updates and reliability',['GitHub and GitCode update mirrors','Resumable downloads and newest-version selection','SHA-256 plus RSA-3072 signature verification','Seamless updates, recovery, and manual rollback']]];
---
<BaseLayout locale="en" title="Features · GenshinPiano" description="Explore GenshinPiano piano-roll editing, MIDI and MusicXML import, OCR, preview, and safe in-game performance."><section class="page-hero shell"><span class="eyebrow">FEATURES</span><h1>A focused toolkit<br />for arranging and playing</h1><p>From the first note to in-game playback, every feature is designed for clarity, control, and safety.</p></section><section class="section shell"><div class="feature-detail-grid">{groups.map(([title,items],i)=><article class="card detail-card"><span class="card-index">0{i+1}</span><h2>{title}</h2><ul>{(items as string[]).map(item=><li>{item}</li>)}</ul></article>)}</div></section><section class="cta shell"><div><h2>Start creating a score</h2><p>Choose the Windows build that fits your setup.</p></div><a class="button button-primary" href="/en/download/">Go to downloads</a></section></BaseLayout>