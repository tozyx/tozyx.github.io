---
import BaseLayout from '../../layouts/BaseLayout.astro';
const sections=[
 {id:'start',title:'Getting started',body:['Fully extract the release ZIP into a writable folder. Do not run inside the archive or place it under Program Files.','Run GenshinPiano.exe. The first launch follows your Windows language and theme.'],items:['Use the + beside Current Score to create a project','Use File → Open for .gpiano, MIDI, or MusicXML','You can also drag supported files into the main window']},
 {id:'library',title:'Files and score library',body:['The app is portable. Settings, logs, update caches, and add-ons remain in the application folder.'],items:['Ctrl + N creates; Ctrl + O opens; Ctrl + Shift + S saves as','A chosen score folder lists .gpiano and .mid files in its current level','Rename with the context menu or F2; file and score titles update together','Unsaved work is checked before switching files or closing','Register .gpiano under Settings → File association']},
 {id:'editor',title:'Piano-roll editing',body:['The snap grid controls movement and creation steps. New-note length follows the most recently used duration.'],items:['Click empty grid space to create; drag notes to move','Ctrl + click or marquee adds to selection; Ctrl + A selects all','Arrow keys move by the grid; add Shift to move one beat','Ctrl + drag copies; Delete removes; Ctrl + Z / Y undo or redo','Drag the right edge for beat length; right-click for key-hold ratio']},
 {id:'preview',title:'Timeline and local preview',body:['Displayed time follows BPM. Local preview never sends keys to the game.'],items:['Click or drag the ruler to place the playhead','Space plays or pauses; selected notes can loop','Ctrl + wheel zooms horizontally; Shift + wheel scrolls','Ctrl + Shift + wheel zooms vertically','Adjust BPM, sustain, volume, and instrument at the bottom']},
 {id:'game',title:'In-game performance',body:['If the game is elevated, manually run GenshinPiano as administrator too. The app never requests elevation by itself.'],items:['Press F5, then focus YuanShen.exe or GenshinImpact.exe','Playback begins after the game stays focused for three seconds','Losing focus pauses; returning resumes','Press Escape in the game to pause and release keys','Shift + F5 stops; shutdown and failure paths force key release']},
 {id:'import',title:'MIDI, MusicXML, and legacy scores',body:['Keep imported short notes as-is or regenerate key-hold lengths with the Edit menu tools.'],items:['Open MIDI for interactive import','Keep the original 0–127 pitch or map into the 21-key range','MusicXML supports measures, voices, chords, ties, and piano parts','Batch conversion handles the selected folder level without recursion','Convert legacy .GenshinPiano files into .gpiano']},
 {id:'ocr',title:'Numbered-notation OCR',body:['OCR is experimental. Complex layouts, low resolution, watermarks, and ties may need manual correction after import.'],items:['Open Import → OCR score recognition','Download the separately signed add-on on first use','Choose image, notation type, watermark suppression, and accompaniment','Review note count and confidence before import','OCR completion notifications are configurable']},
 {id:'updates',title:'Updates, rollback, and network',body:['Network access, automatic updates, and preview releases are controlled under Settings → Updates.'],items:['Check GitHub and GitCode update mirrors','Resume downloads and verify SHA-256 plus RSA signatures','Restart to install; failures attempt to restore the old build','Manual rollback restores the most recent pre-update backup','Main-app updates do not remove the OCR add-on']},
 {id:'support',title:'Logs and support',body:['Logs are stored in the logs folder beside the app. Keep relevant logs for crashes, update failures, and OCR issues.'],items:['Include Windows and application versions','Describe steps that reproduce the issue','Review local paths and score names before sharing logs']}
];
---
<BaseLayout locale="en" title="Documentation · GenshinPiano" description="Complete GenshinPiano guide covering setup, editing, imports, preview, game performance, OCR, and updates."><section class="page-hero shell docs-hero"><span class="eyebrow">DOCUMENTATION</span><h1>Online documentation</h1><p>Search features, shortcuts, and troubleshooting across the complete guide.</p><label class="docs-search"><span>⌕</span><input type="search" placeholder="Search docs: MIDI, shortcuts, updates…" data-doc-search /></label></section><section class="docs-layout shell"><aside class="docs-nav"><strong>Contents</strong>{sections.map(section=><a href={`#${section.id}`}>{section.title}</a>)}</aside><div class="docs-content" data-doc-content>{sections.map(section=><article id={section.id} data-doc-section><h2>{section.title}</h2>{section.body.map(text=><p>{text}</p>)}<ul>{section.items.map(item=><li>{item}</li>)}</ul></article>)}<p class="docs-empty" data-doc-empty hidden>No matching content. Try a shorter search term.</p></div></section><script>const input=document.querySelector<HTMLInputElement>('[data-doc-search]'),sections=document.querySelectorAll<HTMLElement>('[data-doc-section]'),empty=document.querySelector<HTMLElement>('[data-doc-empty]');input?.addEventListener('input',()=>{const query=input.value.trim().toLocaleLowerCase();let visible=0;sections.forEach(section=>{const match=!query||section.textContent?.toLocaleLowerCase().includes(query);section.hidden=!match;if(match)visible++;});if(empty)empty.hidden=visible>0;});</script></BaseLayout>