import BaseLayout from '../../layouts/BaseLayout.astro'; const steps=[['01','Extract and launch','Fully extract the ZIP into a writable folder, then run GenshinPiano.exe.'],['02','Create or import','Start a .gpiano score or drop in MIDI, MusicXML, or a legacy score.'],['03','Edit and preview','Adjust notes, BPM, duration, range, and instrument in the piano roll.'],['04','Focus the game','Press F5, focus the game window, and wait for the three-second countdown.']]; const shortcuts=[['Ctrl + N','New score'],['Ctrl + O','Open score or MIDI'],['Ctrl + Shift + S','Save as'],['Space','Play / pause preview'],['F5','Start game performance'],['Shift + F5','Stop performance'],['Ctrl + Z / Y','Undo / redo'],['Ctrl + wheel','Horizontal zoom']];
