---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PianoDemo from '../../components/PianoDemo.astro'; import ProductShowcase from '../../components/ProductShowcase.astro';
const features=[['Piano-roll editor','Switch between the 21-key layout, full 88-key piano, or the range used by the score.'],['Flexible imports','Import MIDI, MusicXML, and legacy scores; experimental OCR recognizes numbered notation.'],['Safe performance','Target-window detection, focus-loss pause, global Escape, and guaranteed key release.'],['Local preview','Multiple instruments, natural sustain, selection loops, BPM, and volume controls.'],['Trusted updates','Dual mirrors, resumable downloads, SHA-256 and RSA verification, plus rollback.'],['Portable and open','No installer required. Settings and scores stay with the app; source is MIT licensed.']];
---
<BaseLayout locale="en"><section class="hero shell"><div><span class="eyebrow">Windows music companion</span><h1 class="hero-title"><span class="title-line">Turn every melody</span><span class="title-line">into <em>playable notes</em></span></h1><p class="lead">A modern score tool built for Genshin instruments. Import, edit, preview, and perform your music safely in game.</p><div class="actions"><a class="button button-primary" href="/en/download/">Download GenshinPiano</a><a class="button button-secondary" href="/en/docs/">Read the docs</a></div><p class="platform">Windows 10/11 x64 · Free and open source · Portable</p></div><PianoDemo /></section><ProductShowcase locale="en" /><section class="section shell"><div class="section-heading"><span class="eyebrow">CORE FEATURES</span><h2>A complete path from score to performance</h2></div><div class="cards feature-grid">{features.map(([title,copy],i)=><article class="card"><span class="card-index">0{i+1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="center-action"><a class="text-link" href="/en/features/">Explore every feature →</a></div></section><section class="cta shell"><div><span class="eyebrow">GET STARTED</span><h2>Bring your next song into Teyvat</h2></div><a class="button button-primary" href="/en/download/">Choose a download</a></section></BaseLayout>