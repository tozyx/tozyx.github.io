---
import BaseLayout from '../layouts/BaseLayout.astro';
const sections=[
 {id:'start',title:'开始使用',body:['将发布 ZIP 完整解压到具有写入权限的文件夹，不要在压缩包内运行，也不要放入 Program Files。','运行 GenshinPiano.exe。首次启动会根据 Windows 设置选择语言和主题。'],items:['点击左侧“当前曲谱”旁的 + 新建曲谱','从“文件 → 打开”载入 .gpiano、MIDI 或 MusicXML','也可以把支持的文件直接拖到主窗口']},
 {id:'library',title:'文件与曲谱库',body:['软件采用便携模式，设置、日志、更新缓存和附加组件均保存在程序目录。'],items:['Ctrl + N 新建；Ctrl + O 打开；Ctrl + Shift + S 另存为','选择曲谱文件夹后，列表显示当前层的 .gpiano 和 .mid 文件','右键或按 F2 重命名，文件名与曲谱标题同步更新','存在未保存修改时，切换文件或退出前会提示保存','可在“设置 → 文件关联”注册 .gpiano']},
 {id:'editor',title:'卷帘编辑',body:['吸附网格决定创建和移动的步进；新建长度会继承最近创建、调整或选中的音符长度。'],items:['单击空白网格创建音符；拖动音符进行移动','Ctrl + 单击或框选追加选择；Ctrl + A 全选','方向键按网格移动，Shift + 方向键移动一拍','Ctrl + 拖动复制；Delete 删除；Ctrl + Z / Y 撤销或重做','拖动右边缘调整节拍长度；右键设置按键持续比例']},
 {id:'preview',title:'时间轴与本地试听',body:['时间显示会根据 BPM 自动计算，本地试听不会向游戏发送按键。'],items:['单击或拖动顶部时间尺设置播放游标','Space 播放或暂停；选中音符后可以循环试听','Ctrl + 滚轮水平缩放；Shift + 滚轮横向滚动','Ctrl + Shift + 滚轮垂直缩放','底部可调整 BPM、自然延音、音量与音色']},
 {id:'game',title:'游戏内演奏',body:['如果游戏以管理员身份运行，需要手动以管理员身份启动 GenshinPiano；软件不会自动申请管理员权限。'],items:['按 F5 后切换到 YuanShen.exe 或 GenshinImpact.exe','目标窗口连续保持前台三秒后开始演奏','游戏失焦时自动暂停，重新聚焦后继续','游戏窗口中按 Esc 暂停并释放按键','Shift + F5 停止；结束或异常退出时强制释放模拟按键']},
 {id:'import',title:'MIDI、MusicXML 与旧版曲谱',body:['导入后可以保留原始短音，也可以使用编辑菜单中的时长工具重新生成。'],items:['直接打开 MIDI 进入交互式导入流程','MIDI 可保留 0–127 原始音高或映射到 21 键','MusicXML 支持小节、声部、和弦、连音与钢琴声部','批量转换处理所选目录当前层，不递归子目录','旧版 .GenshinPiano 可批量转换为 .gpiano']},
 {id:'ocr',title:'OCR 简谱识别',body:['OCR 是实验性功能，复杂排版、低分辨率、水印和连音可能产生错误；导入后请试听和校对。'],items:['从“导入 → OCR 曲谱识别”打开','首次使用时下载经过签名验证的独立附加包','选择图片、谱面类型、水印抑制和伴奏识别','完成后检查音符数量与置信度再导入','可在通知设置中控制 OCR 完成通知']},
 {id:'updates',title:'更新、回滚与联网',body:['联网、自动更新和预览版本都可在“设置 → 更新”中控制。'],items:['GitHub 与 GitCode 双源检查更新','断点下载并验证 SHA-256 与 RSA 签名','下载完成后重启安装，失败时尽量恢复旧版本','手动回滚可恢复最近一次更新前备份','更新或回滚主程序不会删除 OCR 附加包']},
 {id:'support',title:'日志与反馈',body:['日志位于程序目录的 logs 文件夹。出现崩溃、更新失败或 OCR 异常时，请保留对应日志。'],items:['提交 Issue 前写明系统版本和软件版本','说明可重复出现问题的操作步骤','分享日志前检查本机路径和曲谱名称']}
];
---
<BaseLayout title="在线文档 · GenshinPiano" description="GenshinPiano 完整在线用户指南：安装、卷帘编辑、导入、试听、游戏演奏、OCR 和更新。"><section class="page-hero shell docs-hero"><span class="eyebrow">DOCUMENTATION</span><h1>在线使用文档</h1><p>搜索功能、快捷键或问题，快速定位完整操作说明。</p><label class="docs-search"><span>⌕</span><input type="search" placeholder="搜索文档，例如 MIDI、快捷键、更新…" data-doc-search /></label></section><section class="docs-layout shell"><aside class="docs-nav"><strong>目录</strong>{sections.map(section=><a href={`#${section.id}`}>{section.title}</a>)}</aside><div class="docs-content" data-doc-content>{sections.map(section=><article id={section.id} data-doc-section><h2>{section.title}</h2>{section.body.map(text=><p>{text}</p>)}<ul>{section.items.map(item=><li>{item}</li>)}</ul></article>)}<p class="docs-empty" data-doc-empty hidden>没有找到匹配内容，请尝试更短的关键词。</p></div></section><script>const input=document.querySelector<HTMLInputElement>('[data-doc-search]'),sections=document.querySelectorAll<HTMLElement>('[data-doc-section]'),empty=document.querySelector<HTMLElement>('[data-doc-empty]');input?.addEventListener('input',()=>{const query=input.value.trim().toLocaleLowerCase();let visible=0;sections.forEach(section=>{const match=!query||section.textContent?.toLocaleLowerCase().includes(query);section.hidden=!match;if(match)visible++;});if(empty)empty.hidden=visible>0;});</script></BaseLayout>