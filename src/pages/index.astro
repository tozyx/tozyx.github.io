---
import BaseLayout from '../layouts/BaseLayout.astro';
import PianoDemo from '../components/PianoDemo.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
const features = [['钢琴卷帘','在 21 键、88 键或已用音域间切换，精确编辑音符与持续时间。'],['多格式导入','导入 MIDI、MusicXML 与旧版曲谱；实验性 OCR 可识别数字简谱。'],['安全演奏','目标窗口检测、失焦暂停、全局 Esc 与异常退出按键释放。'],['本地试听','多音色、自然延音、选区循环、BPM 与音量即时调整。'],['可靠更新','双更新源、断点下载、SHA-256 与 RSA 签名校验，以及手动回滚。'],['便携与开放','无需安装，设置与曲谱随程序保存；源代码采用 MIT License。']];
---
<BaseLayout><section class="hero shell"><div><span class="eyebrow">Windows music companion</span><h1 class="hero-title"><span class="title-line">让每一段旋律</span><span class="title-line">都能<em>落在琴键上</em></span></h1><p class="lead">为原神演奏而生的现代乐谱工具。导入、编辑、试听并安全地在游戏中演奏你的音乐。</p><div class="actions"><a class="button button-primary" href="/download/">下载 GenshinPiano</a><a class="button button-secondary" href="/docs/">查看在线文档</a></div><p class="platform">Windows 10/11 x64 · 免费开源 · 便携运行</p></div><PianoDemo /></section><ProductShowcase locale="zh" /><section class="section shell"><div class="section-heading"><span class="eyebrow">核心能力</span><h2>从乐谱到游戏演奏，一条完整工作流</h2></div><div class="cards feature-grid">{features.map(([title,copy],i) => <article class="card"><span class="card-index">0{i+1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="center-action"><a class="text-link" href="/features/">查看全部功能 →</a></div></section><section class="cta shell"><div><span class="eyebrow">准备开始</span><h2>把下一首曲子带进提瓦特</h2></div><a class="button button-primary" href="/download/">选择下载版本</a></section></BaseLayout>