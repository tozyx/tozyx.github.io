---
import PracticeKeyIcon from './PracticeKeyIcon.astro';
interface Props { locale: 'zh' | 'en'; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const rows=[
 {name:zh?'高音':'High',keys:['Q','W','E','R','T','Y','U'],notes:['C5','D5','E5','F5','G5','A5','B5']},
 {name:zh?'中音':'Mid',keys:['A','S','D','F','G','H','J'],notes:['C4','D4','E4','F4','G4','A4','B4']},
 {name:zh?'低音':'Low',keys:['Z','X','C','V','B','N','M'],notes:['C3','D3','E3','F3','G3','A3','B3']}
];
---
<div class="practice-studio" data-practice-studio data-locale={locale} tabindex="-1">
<header class="practice-toolbar"><div class="practice-piece"><span data-score-kind>{zh?'示例练习':'SAMPLE EXERCISE'}</span><strong data-score-title>{zh?'晨风练习曲':'Morning Breeze Study'}</strong></div><div class="practice-settings-panel" data-settings-panel><div class="practice-mode" data-active="follow" role="group" aria-label={zh?'练习模式':'Practice mode'}><button class="active" type="button" data-mode="follow">{zh?'跟弹模式':'Follow'}</button><button type="button" data-mode="timed">{zh?'节奏模式':'Timed'}</button></div><label class="practice-speed"><span>{zh?'速度':'Speed'}</span><select data-speed><option value=".25">25%</option><option value=".5">50%</option><option value=".75">75%</option><option value="1" selected>100%</option><option value="1.25">125%</option></select></label><label class="practice-instrument"><span>{zh?'音色':'Sound'}</span><select data-instrument><option value="Lyre">{zh?'风物之诗琴':'Lyre'}</option><option value="Vintage-Lyre">{zh?'老旧的诗琴':'Vintage Lyre'}</option><option value="Zither">{zh?'镜花之琴':'Zither'}</option><option value="Old-Zither">{zh?'镜花之琴（旧版）':'Old Zither'}</option><option value="Ukulele">{zh?'悠可琴':'Ukulele'}</option><option value="LingeringEuphonia">{zh?'「余音」':'Lingering Euphonia'}</option><option value="LeapingSpiritPiano">{zh?'跃律琴':'Leaping Spirit Piano'}</option><option value="HarmonicKey">{zh?'和璇之钥':'Harmonic Key'}</option></select></label></div><button class="practice-settings-toggle" type="button" data-settings-toggle aria-label={zh?'练习设置':'Practice settings'} title={zh?'练习设置':'Practice settings'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M6 14v6"/></svg></button><button class="practice-fullscreen" type="button" data-fullscreen aria-label={zh?'进入全屏':'Enter fullscreen'} title={zh?'进入全屏':'Enter fullscreen'}><svg class="expand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M21 16v5h-5M8 21H3v-5"/></svg><svg class="restore-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3v6H3M15 3v6h6M21 15h-6v6M3 15h6v6"/></svg></button><button class="practice-action" type="button" data-action>{zh?'开始练习':'Start practice'}</button></header>
<div class="practice-progress"><i data-progress></i></div>
<section class="cue-stage" aria-live="polite"><div class="cue-copy"><span data-mode-label></span><strong data-cue-title>{zh?'准备开始':'Ready'}</strong><p data-cue-help>{zh?'按下高亮琴键，或使用电脑键盘。':'Press the highlighted keys or use your keyboard.'}</p></div><div class="cue-center"><div class="cue-sequence" data-cues></div><div class="practice-scrubber"><button type="button" data-step="-1" aria-label={zh?'上一个音节':'Previous note'} title={zh?'上一个音节':'Previous note'}>‹</button><div class="seek-track"><i aria-hidden="true"></i><b aria-hidden="true"></b><input data-seek type="range" min="0" max="13" value="0" step="1" aria-label={zh?'练习进度':'Practice position'} /></div><button type="button" data-step="1" aria-label={zh?'下一个音节':'Next note'} title={zh?'下一个音节':'Next note'}>›</button><div class="loop-controls" aria-label={zh?'片段循环':'Section loop'}><button type="button" data-loop-start aria-label={zh?'将当前音节设为循环起点 A':'Set current note as loop point A'} title={zh?'设为循环起点 A':'Set loop point A'}>A</button><button type="button" data-loop-end aria-label={zh?'将当前音节设为循环终点 B':'Set current note as loop point B'} title={zh?'设为循环终点 B':'Set loop point B'}>B</button><button type="button" data-loop-clear aria-label={zh?'清除循环范围':'Clear loop range'} title={zh?'清除循环':'Clear loop'}>↺</button><span data-loop-status title={zh?'当前循环范围':'Current loop range'}>—</span></div></div></div><div class="practice-stats"><span><b data-combo>0</b>{zh?'连击':'Combo'}</span><span><b data-accuracy>—</b>{zh?'正确率':'Accuracy'}</span></div></section>
<div class="lyre-board">{rows.map((row,rowIndex)=><div class="lyre-row"><div class="lyre-register"><span>{row.name}</span><i>{rowIndex===0?'♬':rowIndex===1?'𝄞':'𝄢'}</i></div><div class="lyre-keys">{row.keys.map((key,index)=><button class="lyre-key" type="button" data-key={key} data-note={row.notes[index]} data-degree={index} aria-label={row.notes[index]+' · '+key}><PracticeKeyIcon degree={index} /><span class="lyre-key-note">{row.notes[index]}</span><strong>{key}</strong><i></i></button>)}</div></div>)}</div>
<footer class="practice-footer"><span data-status>{zh?'选择模式后开始；当前使用内置示例序列。':'Choose a mode and start; this uses a built-in sample.'}</span><div class="practice-footer-actions"><label class="practice-import"><input data-score-file type="file" accept=".gpiano,application/json" /><span>{zh?'导入曲谱':'Import score'}</span></label><button type="button" data-reset>{zh?'重新开始':'Restart'}</button></div></footer>
<div class="practice-drop-overlay" data-drop-overlay><strong>{zh?'松开以导入曲谱':'Drop to import score'}</strong><span>.gpiano · JSON</span></div>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-practice-studio]').forEach(studio=>{
 type PracticeStep={keys:string[];timeMs:number};
 const zh=studio.dataset.locale!=='en',builtIn=[['A'],['S'],['D'],['A','D'],['G'],['H'],['G'],['D'],['S'],['A'],['Z'],['C'],['B'],['A','D','G']];
 let sequence:PracticeStep[]=builtIn.map((keys,index)=>({keys,timeMs:index*750})),currentBpm=120;
 const instrumentVisuals={Lyre:{fill:'#9288d3',click:'#9591df',icons:['do','re','mi','fa','so','la','ti']},'Vintage-Lyre':{fill:'#7fb363',click:'#6c9f52',icons:['do','reb','mib','fa','so','lab','tib']},Zither:{fill:'#cdb68e',click:'#ddcba8',icons:['do','re','mi','fa','so','la','ti']},'Old-Zither':{fill:'#cdb68e',click:'#ddcba8',icons:['do','re','mi','fa','so','la','ti']},Ukulele:{fill:'#4d719a',click:'#6586d9',icons:['do','re','mi','fa','so','la','ti']},LingeringEuphonia:{fill:'#9288d3',click:'#9591df',icons:['do','re','mi','fa','so','la','ti']},LeapingSpiritPiano:{fill:'#5cadbd',click:'#5cadbd',icons:['do','re','mi','fa','so','la','ti']},HarmonicKey:{fill:'#ddb055',click:'#e1cba3',icons:['do','re','mi','fa','so','la','ti']}} as const;
 const keys=['Z','X','C','V','B','N','M','A','S','D','F','G','H','J','Q','W','E','R','T','Y','U'],sampleKeys=['Q','W','E','R','T','Y','U','A','S','D','F','G','H','J','Z','X','C','V','B','N','M'],buttons=[...studio.querySelectorAll<HTMLButtonElement>('[data-key]')],modes=[...studio.querySelectorAll<HTMLButtonElement>('[data-mode]')];
 const action=studio.querySelector<HTMLButtonElement>('[data-action]'),speed=studio.querySelector<HTMLSelectElement>('[data-speed]'),instrument=studio.querySelector<HTMLSelectElement>('[data-instrument]'),title=studio.querySelector<HTMLElement>('[data-cue-title]'),help=studio.querySelector<HTMLElement>('[data-cue-help]'),label=studio.querySelector<HTMLElement>('[data-mode-label]'),cues=studio.querySelector<HTMLElement>('[data-cues]'),progress=studio.querySelector<HTMLElement>('[data-progress]'),comboEl=studio.querySelector<HTMLElement>('[data-combo]'),accuracy=studio.querySelector<HTMLElement>('[data-accuracy]'),status=studio.querySelector<HTMLElement>('[data-status]'),seek=studio.querySelector<HTMLInputElement>('[data-seek]'),loopStatus=studio.querySelector<HTMLElement>('[data-loop-status]'),loopA=studio.querySelector<HTMLButtonElement>('[data-loop-start]'),loopB=studio.querySelector<HTMLButtonElement>('[data-loop-end]'),loopClear=studio.querySelector<HTMLButtonElement>('[data-loop-clear]'),fullscreenButton=studio.querySelector<HTMLButtonElement>('[data-fullscreen]'),settingsToggle=studio.querySelector<HTMLButtonElement>('[data-settings-toggle]'),scoreFile=studio.querySelector<HTMLInputElement>('[data-score-file]'),scoreTitle=studio.querySelector<HTMLElement>('[data-score-title]'),scoreKind=studio.querySelector<HTMLElement>('[data-score-kind]'),dropOverlay=studio.querySelector<HTMLElement>('[data-drop-overlay]');
 let mode='follow',index=0,combo=0,hits=0,attempts=0,running=false,timer=0,loopStart=-1,loopEnd=-1,audio:AudioContext|null=null;const pressed=new Set<string>(),sampleCache=new Map<string,AudioBuffer>(),sampleLoads=new Map<string,Promise<AudioBuffer>>();
 const focusPerformance=()=>studio.focus({preventScroll:true});
 const isHarmony=/HarmonyOS|HongMeng|ArkWeb/i.test(navigator.userAgent);const isMobileFullscreen=()=>isHarmony||matchMedia('(max-width: 900px), (pointer: coarse)').matches;const isEmulatedMobile=()=>innerWidth<=900&&outerWidth>innerWidth*1.35;
 let pageExpanded=false;
 const animateFullscreenChange=()=>studio.animate([{opacity:.72,transform:'scale(.988)'},{opacity:1,transform:'scale(1)'}],{duration:360,easing:'cubic-bezier(.22,.8,.25,1)'});
 const updateFullscreenButton=(active:boolean)=>{if(!fullscreenButton)return;fullscreenButton.classList.toggle('active',active);fullscreenButton.setAttribute('aria-label',active?(zh?'还原练习区':'Restore practice area'):(zh?'展开练习区':'Expand practice area'));fullscreenButton.title=active?(zh?'还原练习区':'Restore practice area'):(zh?'展开练习区':'Expand practice area');};
 const setPageExpanded=(active:boolean,simulateLandscape=false)=>{pageExpanded=active;studio.classList.toggle('page-expanded',active);studio.classList.toggle('is-fullscreen',active);studio.classList.toggle('mobile-preview',active&&simulateLandscape);studio.classList.toggle('virtual-landscape',active&&simulateLandscape&&matchMedia('(orientation: portrait)').matches);document.body.classList.toggle('practice-page-fullscreen',active);updateFullscreenButton(active);animateFullscreenChange();focusPerformance();};
 const syncFullscreen=()=>{const active=document.fullscreenElement===studio;studio.classList.toggle('is-fullscreen',active);updateFullscreenButton(active||pageExpanded);animateFullscreenChange();};
 const toggleFullscreen=async()=>{if(!isMobileFullscreen()){setPageExpanded(!pageExpanded);return;}if(isEmulatedMobile()){setPageExpanded(!pageExpanded,true);return;}try{if(document.fullscreenElement){await document.exitFullscreen();return;}await studio.requestFullscreen();const orientation=screen.orientation as ScreenOrientation&{lock?:(value:string)=>Promise<void>};await orientation.lock?.('landscape').catch(()=>{});}catch{if(status)status.textContent=zh?'浏览器未允许全屏，请检查权限设置。':'Fullscreen was blocked by the browser.';}finally{focusPerformance();}};
 settingsToggle?.addEventListener('click',()=>{const open=studio.classList.toggle('settings-open');settingsToggle.setAttribute('aria-expanded',String(open));});
 fullscreenButton?.addEventListener('click',toggleFullscreen);document.addEventListener('fullscreenchange',syncFullscreen);window.addEventListener('keydown',event=>{if(event.key==='Escape'&&pageExpanded)setPageExpanded(false);});
 const enhanceSelect=(select:HTMLSelectElement|null)=>{if(!select)return;select.classList.add('native-select');const shell=document.createElement('div');shell.className='custom-select';const trigger=document.createElement('button');trigger.type='button';trigger.className='custom-select-trigger';trigger.setAttribute('aria-haspopup','listbox');trigger.setAttribute('aria-expanded','false');const value=document.createElement('span'),arrow=document.createElement('i');arrow.setAttribute('aria-hidden','true');trigger.append(value,arrow);const menu=document.createElement('div');menu.className='custom-select-menu';menu.setAttribute('role','listbox');const close=()=>{shell.classList.remove('open');trigger.setAttribute('aria-expanded','false');};[...select.options].forEach(option=>{const item=document.createElement('button');item.type='button';item.className='custom-select-option';item.textContent=option.text;item.dataset.value=option.value;item.setAttribute('role','option');item.addEventListener('click',()=>{select.value=option.value;select.dispatchEvent(new Event('change',{bubbles:true}));value.textContent=option.text;menu.querySelectorAll('.custom-select-option').forEach(node=>{const selected=(node as HTMLElement).dataset.value===option.value;node.classList.toggle('selected',selected);node.setAttribute('aria-selected',String(selected));});close();});menu.append(item);});const sync=()=>{value.textContent=select.selectedOptions[0]?.text||'';menu.querySelectorAll('.custom-select-option').forEach(node=>{const selected=(node as HTMLElement).dataset.value===select.value;node.classList.toggle('selected',selected);node.setAttribute('aria-selected',String(selected));});};trigger.addEventListener('click',()=>{const open=!shell.classList.contains('open');studio.querySelectorAll('.custom-select.open').forEach(node=>node!==shell&&node.classList.remove('open'));shell.classList.toggle('open',open);trigger.setAttribute('aria-expanded',String(open));});trigger.addEventListener('keydown',event=>{if(event.key==='Escape'){close();trigger.focus();}if(['ArrowDown','ArrowUp'].includes(event.key)){event.preventDefault();shell.classList.add('open');trigger.setAttribute('aria-expanded','true');const items=[...menu.querySelectorAll<HTMLButtonElement>('button')],selected=Math.max(0,items.findIndex(item=>item.classList.contains('selected'))),next=event.key==='ArrowDown'?Math.min(items.length-1,selected+1):Math.max(0,selected-1);items[next]?.focus();}});select.addEventListener('change',sync);select.insertAdjacentElement('afterend',shell);shell.append(trigger,menu);sync();};
 enhanceSelect(speed);enhanceSelect(instrument);
 const loadSample=(sound:string,key:string)=>{const sampleIndex=sampleKeys.indexOf(key),cacheKey=`${sound}/${sampleIndex}`;if(sampleCache.has(cacheKey))return Promise.resolve(sampleCache.get(cacheKey)!);if(sampleLoads.has(cacheKey))return sampleLoads.get(cacheKey)!;audio||=new AudioContext();const request=fetch(`/practice/audio/${sound}/${sampleIndex}.mp3`).then(response=>{if(!response.ok)throw new Error(`Audio ${response.status}`);return response.arrayBuffer();}).then(data=>audio!.decodeAudioData(data)).then(buffer=>{sampleCache.set(cacheKey,buffer);sampleLoads.delete(cacheKey);return buffer;}).catch(error=>{sampleLoads.delete(cacheKey);throw error;});sampleLoads.set(cacheKey,request);return request;};
 const preload=(sound:string)=>sampleKeys.forEach(key=>void loadSample(sound,key).catch(()=>{}));
 const applyInstrumentVisuals=()=>{const sound=(instrument?.value||'Lyre') as keyof typeof instrumentVisuals,visual=instrumentVisuals[sound]||instrumentVisuals.Lyre;studio.style.setProperty('--instrument-color',visual.fill);studio.style.setProperty('--instrument-active',visual.click);buttons.forEach(button=>{const degree=Number(button.dataset.degree||0),icon=visual.icons[degree];button.dataset.icon=icon;const image=button.querySelector<HTMLElement>('.practice-key-icon'),note=button.querySelector<HTMLElement>('.lyre-key-note'),noteNames:{[key:string]:string}={do:'C',re:'D',reb:'D♭',mi:'E',mib:'E♭',fa:'F',so:'G',la:'A',lab:'A♭',ti:'B',tib:'B♭'},octave=5-Math.floor(sampleKeys.indexOf(button.dataset.key||'')/7);if(image)image.style.setProperty('--key-icon',`url('/practice/icons/${icon.replace('b','')}.svg')`);if(note)note.textContent=`${noteNames[icon]}${octave}`;button.setAttribute('aria-label',`${noteNames[icon]}${octave} · ${button.dataset.key}`);button.classList.toggle('flat-note',icon.endsWith('b'));});};
 const tone=async(key:string)=>{audio||=new AudioContext();if(audio.state==='suspended')await audio.resume();const sound=instrument?.value||'Lyre';try{const buffer=await loadSample(sound,key),source=audio.createBufferSource(),gain=audio.createGain();source.buffer=buffer;gain.gain.value=.72;source.connect(gain).connect(audio.destination);source.start();}catch{if(status)status.textContent=zh?'音色加载失败，请刷新后重试。':'Could not load the instrument. Please refresh and try again.';}};
 const pitchKeys=new Map([[48,'Z'],[50,'X'],[52,'C'],[53,'V'],[55,'B'],[57,'N'],[59,'M'],[60,'A'],[62,'S'],[64,'D'],[65,'F'],[67,'G'],[69,'H'],[71,'J'],[72,'Q'],[74,'W'],[76,'E'],[77,'R'],[79,'T'],[81,'Y'],[83,'U']]);
 const tickToMs=(tick:number,ppq:number,tempoMap:{tick:number;bpm:number}[])=>{let elapsed=0;for(let i=0;i<tempoMap.length;i++){const current=tempoMap[i];if(current.tick>=tick)break;const end=i+1<tempoMap.length?Math.min(tick,tempoMap[i+1].tick):tick;elapsed+=(end-current.tick)*60000/(current.bpm*ppq);if(end===tick)break;}return elapsed;};
 const decodeScore=(raw:string)=>{const data=JSON.parse(raw);if(data?.schemaVersion!==1)throw new Error(zh?'仅支持 schemaVersion 1。':'Only schemaVersion 1 is supported.');const ppq=Number(data?.timing?.ppq),tempoMap=[...(data?.timing?.tempoMap||[])].map((item:any)=>({tick:Number(item.tick),bpm:Number(item.bpm)})).sort((a,b)=>a.tick-b.tick);if(!(ppq>0)||!tempoMap.length||tempoMap[0].tick!==0||tempoMap.some(item=>item.tick<0||!(item.bpm>0)))throw new Error(zh?'曲谱计时信息无效。':'The score timing data is invalid.');if(data?.playback?.mapping&&String(data.playback.mapping).toLowerCase()!=='genshin-21-key')throw new Error(zh?'曲谱不是 genshin-21-key 键位映射。':'The score does not use the genshin-21-key mapping.');const transpose=Number(data?.playback?.transpose||0),policy=String(data?.playback?.outOfRangePolicy||'reject').toLowerCase(),groups=new Map<number,Set<string>>();let skipped=0,noteCount=0;for(const track of data?.tracks||[]){if(track?.isMuted)continue;for(const note of track?.notes||[]){let pitch=Number(note.pitch)+transpose,startTick=Number(note.startTick);if(!Number.isInteger(pitch)||!Number.isFinite(startTick)||startTick<0)throw new Error(zh?'曲谱包含无效音符。':'The score contains an invalid note.');if(policy==='octavefold'){while(pitch<48)pitch+=12;while(pitch>83)pitch-=12;}const key=pitchKeys.get(pitch);if(!key){if(policy==='reject')throw new Error((zh?'存在无法映射到 21 键的音高：':'A pitch cannot be mapped to the 21 keys: ')+pitch);skipped++;continue;}if(!groups.has(startTick))groups.set(startTick,new Set());groups.get(startTick)!.add(key);noteCount++;}}const steps=[...groups.entries()].sort((a,b)=>a[0]-b[0]).map(([tick,keySet])=>({keys:[...keySet],timeMs:tickToMs(tick,ppq,tempoMap)}));if(!steps.length)throw new Error(zh?'曲谱中没有可演奏的音符。':'The score contains no playable notes.');return{steps,title:String(data?.metadata?.title||''),bpm:tempoMap[0].bpm,noteCount,skipped};};
 const importScore=async(file:File)=>{try{if(file.size>5*1024*1024)throw new Error(zh?'文件不能超过 5 MB。':'The file must be 5 MB or smaller.');const decoded=decodeScore(await file.text());running=false;clearTimeout(timer);sequence=decoded.steps;currentBpm=decoded.bpm;index=combo=hits=attempts=0;loopStart=loopEnd=-1;pressed.clear();if(cues)cues.replaceChildren();if(seek)seek.max=String(sequence.length-1);if(scoreTitle)scoreTitle.textContent=decoded.title||file.name.replace(/\.gpiano$/i,'');if(scoreKind)scoreKind.textContent=zh?'导入曲谱':'IMPORTED SCORE';if(action)action.textContent=zh?'开始练习':'Start practice';if(status)status.textContent=(zh?('已解析 '+decoded.noteCount+' 个音符，共 '+sequence.length+' 个音节'):('Parsed '+decoded.noteCount+' notes into '+sequence.length+' steps'))+(decoded.skipped?(zh?('；跳过 '+decoded.skipped+' 个无法映射的音符'):('; skipped '+decoded.skipped+' unmapped notes')):'');draw();focusPerformance();}catch(error){if(status)status.textContent=(zh?'导入失败：':'Import failed: ')+(error instanceof Error?error.message:String(error));}};
 scoreFile?.addEventListener('change',()=>{const file=scoreFile.files?.[0];if(file)void importScore(file);scoreFile.value='';});
 let dragDepth=0;studio.addEventListener('dragenter',event=>{if(!event.dataTransfer?.types.includes('Files'))return;event.preventDefault();dragDepth++;dropOverlay?.classList.add('visible');});studio.addEventListener('dragover',event=>{if(event.dataTransfer?.types.includes('Files'))event.preventDefault();});studio.addEventListener('dragleave',()=>{dragDepth=Math.max(0,dragDepth-1);if(!dragDepth)dropOverlay?.classList.remove('visible');});studio.addEventListener('drop',event=>{event.preventDefault();dragDepth=0;dropOverlay?.classList.remove('visible');const file=event.dataTransfer?.files[0];if(file)void importScore(file);});
 const draw=()=>{
  const target=sequence[index]?.keys||[],percent=sequence.length>1?index/(sequence.length-1)*100:0;
  buttons.forEach(b=>b.classList.toggle('target',running&&target.includes(b.dataset.key||'')));
  if(title)title.textContent=running?target.join(' + '):(zh?'准备开始':'Ready');
  if(label)label.textContent=mode==='follow'?(zh?'跟弹模式 · 等待正确输入':'FOLLOW · WAITS FOR YOU'):(zh?('节奏模式 · '+Math.round(currentBpm)+' BPM'):('TIMED · '+Math.round(currentBpm)+' BPM'));
  if(help)help.textContent=mode==='follow'?(zh?'按齐当前组合后自动前进':'Complete the group to advance'):(zh?'节拍持续前进，尽量准时按下':'The beat keeps moving—play on time');
  if(progress)progress.style.width=percent+'%';
  if(seek){seek.value=String(Math.min(index,sequence.length-1));seek.parentElement?.style.setProperty('--seek-progress',percent+'%');}
  if(comboEl)comboEl.textContent=String(combo);if(accuracy)accuracy.textContent=attempts?Math.round(hits/attempts*100)+'%':'—';
  if(loopStatus){loopStatus.textContent=loopStart>=0&&loopEnd>=0?`${loopStart+1}–${loopEnd+1}`:(loopStart>=0?`A${loopStart+1}`:'—');loopStatus.title=loopStart>=0&&loopEnd>=0?(zh?`循环音节 ${loopStart+1} 到 ${loopEnd+1}`:`Loop notes ${loopStart+1} to ${loopEnd+1}`):(loopStart>=0?(zh?`起点 A：${loopStart+1}，请选择终点 B`:`Point A: ${loopStart+1}; choose B`):(zh?'未设置循环':'No loop selected'));}  loopA?.classList.toggle('active',loopStart===index);loopB?.classList.toggle('active',loopEnd===index);loopClear?.toggleAttribute('disabled',loopStart<0&&loopEnd<0);
  if(cues){if(!cues.childElementCount){sequence.forEach((step,j)=>{const notes=step.keys;const cue=document.createElement('button');cue.type='button';cue.className='cue-note';cue.textContent=notes.join('+');cue.dataset.cueIndex=String(j);cue.setAttribute('aria-label',(zh?'跳转到音节 ':'Go to note ')+(j+1));cue.addEventListener('click',()=>seekTo(j));cues.append(cue);});}const cueButtons=[...cues.querySelectorAll<HTMLButtonElement>('.cue-note')];cueButtons.forEach((cue,j)=>{cue.classList.toggle('past',j<index);cue.classList.toggle('current',j===index);cue.classList.toggle('future',j>index);});const current=cueButtons[index];if(current)requestAnimationFrame(()=>cues.scrollTo({left:current.offsetLeft-(cues.clientWidth-current.offsetWidth)/2,behavior:'smooth'}));}
 };
 const finish=()=>{running=false;clearTimeout(timer);buttons.forEach(b=>b.classList.remove('target'));if(action)action.textContent=zh?'再次练习':'Practice again';if(title)title.textContent=zh?'练习完成':'Complete';if(progress)progress.style.width='100%';};
 const schedule=()=>{clearTimeout(timer);if(running&&mode==='timed'){const current=sequence[index],next=sequence[index+1],delay=Math.max(40,(next?next.timeMs-current.timeMs:750)/Number(speed?.value||1));timer=window.setTimeout(()=>{attempts++;combo=0;advance();},delay);}};
 const advance=()=>{pressed.clear();index++;if(loopStart>=0&&loopEnd>=0&&index>loopEnd)index=loopStart;if(index>=sequence.length){finish();return;}draw();schedule();};
 const play=(key:string)=>{const b=buttons.find(x=>x.dataset.key===key);if(!b)return;tone(key);b.classList.add('pressed');setTimeout(()=>b.classList.remove('pressed'),130);if(!running)return;attempts++;const target=sequence[index]?.keys||[];if(target.includes(key)&&!pressed.has(key)){pressed.add(key);hits++;combo++;b.classList.add('correct');setTimeout(()=>b.classList.remove('correct'),220);if(target.every(k=>pressed.has(k)))advance();}else if(!target.includes(key)){combo=0;b.classList.add('wrong');setTimeout(()=>b.classList.remove('wrong'),220);draw();}else draw();};
 const start=()=>{focusPerformance();clearTimeout(timer);combo=hits=attempts=0;if(index>=sequence.length)index=loopStart>=0?loopStart:0;pressed.clear();running=true;if(action)action.textContent=zh?'暂停':'Pause';if(status)status.textContent=zh?'练习进行中 · 支持键盘和触控':'Practice active · Keyboard and touch enabled';draw();schedule();};
 const seekTo=(next:number)=>{index=Math.max(0,Math.min(sequence.length-1,next));pressed.clear();draw();schedule();focusPerformance();};
 seek?.addEventListener('input',()=>{index=Number(seek.value);pressed.clear();draw();schedule();});seek?.addEventListener('change',focusPerformance);
 studio.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button=>button.addEventListener('click',()=>seekTo(index+Number(button.dataset.step||0))));
 loopA?.addEventListener('click',()=>{loopStart=index;if(loopEnd>=0&&loopEnd<loopStart)loopEnd=-1;draw();focusPerformance();});
 loopB?.addEventListener('click',()=>{loopEnd=index;if(loopStart<0||loopStart>loopEnd)loopStart=0;draw();focusPerformance();});
 loopClear?.addEventListener('click',()=>{loopStart=loopEnd=-1;draw();focusPerformance();});
 action?.addEventListener('click',()=>{if(!running){start();return;}running=false;clearTimeout(timer);action.textContent=zh?'继续':'Resume';buttons.forEach(b=>b.classList.remove('target'));});
 studio.querySelector('[data-reset]')?.addEventListener('click',()=>{index=loopStart>=0?loopStart:0;start();});modes.forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.mode||'follow';if(b.parentElement)b.parentElement.dataset.active=mode;modes.forEach(x=>x.classList.toggle('active',x===b));start();}));speed?.addEventListener('change',()=>{schedule();focusPerformance();});instrument?.addEventListener('change',()=>{applyInstrumentVisuals();preload(instrument.value);focusPerformance();});buttons.forEach(b=>b.addEventListener('pointerdown',e=>{e.preventDefault();play(b.dataset.key||'');}));
 const down=new Set<string>();window.addEventListener('keydown',e=>{const k=e.key.toUpperCase(),tag=(e.target as HTMLElement)?.tagName;if(!keys.includes(k)||down.has(k)||['INPUT','TEXTAREA','SELECT'].includes(tag))return;down.add(k);play(k);});window.addEventListener('keyup',e=>down.delete(e.key.toUpperCase()));document.addEventListener('pointerdown',e=>{if(!(e.target as Element).closest('.practice-settings-panel,.practice-settings-toggle')){studio.classList.remove('settings-open');settingsToggle?.setAttribute('aria-expanded','false');}if(!(e.target as Element).closest('.custom-select'))studio.querySelectorAll('.custom-select.open').forEach(node=>{node.classList.remove('open');node.querySelector('.custom-select-trigger')?.setAttribute('aria-expanded','false');});});applyInstrumentVisuals();draw();requestAnimationFrame(()=>{if(document.activeElement===document.body)focusPerformance();});
});
</script>
