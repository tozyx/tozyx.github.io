---
interface Props { locale: 'zh' | 'en'; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const slides = zh
  ? [
      { src: '/screenshots/editor-zh.png', label: '曲谱编辑', alt: 'GenshinPiano 中文曲谱编辑界面，展示曲谱库和 21 键卷帘编辑器' },
      { src: '/screenshots/practice-roll-zh.png', label: '卷帘练习', alt: 'GenshinPiano 中文垂直卷帘练习界面' },
      { src: '/screenshots/practice-keys-zh.png', label: '游戏按键', alt: 'GenshinPiano 中文游戏按键练习界面' },
      { src: '/screenshots/ocr-import-zh.png', label: 'OCR', alt: 'GenshinPiano 中文 OCR 曲谱识别界面' },
      { src: '/screenshots/dark-theme-zh.png', label: '深色主题', alt: 'GenshinPiano 中文深色主题界面' },
    ]
  : [
      { src: '/screenshots/editor-en.png', label: 'Score editor', alt: 'GenshinPiano score editor in English, showing the score library and 21-key piano roll' },
      { src: '/screenshots/practice-roll-en.png', label: 'Piano roll', alt: 'GenshinPiano vertical-roll practice view in English' },
      { src: '/screenshots/practice-keys-en.png', label: 'Game keys', alt: 'GenshinPiano game-key practice view in English' },
      { src: '/screenshots/ocr-import-en.png', label: 'OCR', alt: 'GenshinPiano OCR score-import window in English' },
      { src: '/screenshots/dark-theme-en.png', label: 'Dark theme', alt: 'GenshinPiano dark theme in English' },
    ];
---
<section class="product-showcase shell" aria-labelledby="product-showcase-title">
  <div class="section-heading">
    <span class="eyebrow">{zh ? '真实软件界面' : 'REAL APPLICATION'}</span>
    <h2 id="product-showcase-title">{zh ? '从编曲到练习，每一步都清晰直观' : 'A clear workspace from arranging to practice'}</h2>
    <p>{zh ? '浏览曲谱编辑、两种练习界面、OCR 导入与深色主题。所有图片均来自 Windows 版 GenshinPiano v3 的实际运行界面。' : 'Explore score editing, two practice views, OCR import, and the dark theme. Every image comes from the real GenshinPiano v3 Windows application.'}</p>
  </div>
  <figure class="product-shot" data-product-carousel>
    <div class="product-shot-viewport">
      <div class="product-shot-track" data-shot-track style={`--slide-count:${slides.length}`}>
        {slides.map((slide, index) => (
          <div class="product-slide" aria-hidden={index !== 0}>
            <img src={slide.src} alt={slide.alt} width="1475" height="898" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
    <figcaption>
      <span>{zh ? '选择界面，或左右滑动图片' : 'Choose a view or swipe the image'}</span>
      <div class="shot-switch" role="group" aria-label={zh ? '软件界面截图' : 'Application screenshots'}>
        <i class="shot-switch-indicator" aria-hidden="true"></i>
        {slides.map((slide, index) => <button type="button" data-shot-index={index}>{slide.label}</button>)}
      </div>
    </figcaption>
  </figure>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-carousel]').forEach(carousel => {
    const track = carousel.querySelector<HTMLElement>('[data-shot-track]');
    const slides = [...carousel.querySelectorAll<HTMLElement>('.product-slide')];
    const buttons = [...carousel.querySelectorAll<HTMLButtonElement>('[data-shot-index]')];
    const switcher = carousel.querySelector<HTMLElement>('.shot-switch');
    const indicator = carousel.querySelector<HTMLElement>('.shot-switch-indicator');
    let current = 0;
    let pointerStart: number | null = null;
    let indicatorReady = false;
    const moveIndicator = () => {
      const button = buttons[current];
      if (!button || !indicator) return;
      indicator.style.width = button.offsetWidth + 'px';
      indicator.style.transform = 'translateX(' + button.offsetLeft + 'px)';
      if (!indicatorReady) {
        requestAnimationFrame(() => indicator.classList.add('ready'));
        indicatorReady = true;
      }
    };
    const show = (index: number) => {
      current = Math.max(0, Math.min(slides.length - 1, index));
      if (track) track.style.transform = `translateX(-${current * (100 / slides.length)}%)`;
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', String(i !== current)));
      buttons.forEach((button, i) => {
        button.classList.toggle('active', i === current);
        button.setAttribute('aria-pressed', String(i === current));
      });
      moveIndicator();
    };
    buttons.forEach((button, i) => button.addEventListener('click', () => show(i)));
    carousel.addEventListener('pointerdown', event => { pointerStart = event.clientX; });
    carousel.addEventListener('pointerup', event => {
      if (pointerStart === null) return;
      const delta = event.clientX - pointerStart;
      if (Math.abs(delta) > 45) show(delta < 0 ? current + 1 : current - 1);
      pointerStart = null;
    });
    carousel.addEventListener('pointercancel', () => { pointerStart = null; });
    if (switcher && 'ResizeObserver' in window) new ResizeObserver(moveIndicator).observe(switcher);
    show(0);
  });
</script>
